<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Registration Successful | EventSpot</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><header class="navbar"><a class="brand" href="${pageContext.request.contextPath}/events"><span class="brand-mark">E</span> EventSpot</a><nav><a href="${pageContext.request.contextPath}/events">Explore Events</a><a class="nav-cta" href="${pageContext.request.contextPath}/registrations">View All Registrations</a></nav></header>
<main class="success-page"><section class="success-card"><div class="success-icon">✓</div><span class="eyebrow">YOU'RE ALL SET</span><h1>Registration successful!</h1><p class="success-lead">Thanks, <strong><c:out value="${name}"/></strong>. Your place has been registered.</p><div class="registration-ticket"><div class="ticket-label">REGISTRATION ID</div><div class="ticket-number">#<c:out value="${registrationId}"/></div><div class="ticket-divider"></div><dl><dt>Event</dt><dd><c:out value="${eventName}"/></dd><dt>Date</dt><dd><c:out value="${eventDate}"/></dd><dt>Venue</dt><dd><c:out value="${venue}"/></dd><dt>Email</dt><dd><c:out value="${email}"/></dd><dt>Phone</dt><dd><c:out value="${phone}"/></dd></dl></div><div class="success-actions"><a class="button button-primary" href="${pageContext.request.contextPath}/events">Back to Events</a><a class="button button-outline" href="${pageContext.request.contextPath}/registrations">View All Registrations</a></div></section></main><footer class="footer"><span>EventSpot</span><span>Discover something worth showing up for.</span></footer></body></html>
