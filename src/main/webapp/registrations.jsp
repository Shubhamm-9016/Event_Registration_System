<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>All Registrations | EventSpot</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><header class="navbar"><a class="brand" href="${pageContext.request.contextPath}/events"><span class="brand-mark">E</span> EventSpot</a><nav><a href="${pageContext.request.contextPath}/events">Explore Events</a><a class="nav-cta" href="${pageContext.request.contextPath}/registrations">View All Registrations</a></nav></header>
<main class="main-content registrations-page"><a class="back-link" href="${pageContext.request.contextPath}/events">← Back to events</a><div class="section-heading"><div><span class="eyebrow">REGISTRATION RECORDS</span><h1>All registrations</h1><p>Registration details currently saved in the system.</p></div><span class="event-count"><c:out value="${registrations.size()}"/> records</span></div>
<c:choose><c:when test="${empty registrations}"><div class="empty-state"><div class="empty-icon">▤</div><h3>No registrations yet</h3><p>Once someone registers for an event, their details will appear here.</p><a class="button button-primary" href="${pageContext.request.contextPath}/events">Explore events</a></div></c:when><c:otherwise><div class="table-card"><div class="table-scroll"><table class="registrations-table"><thead><tr><th>ID</th><th>Participant</th><th>Contact</th><th>Event</th><th>Event date</th><th>Venue</th><th>Registered at</th></tr></thead><tbody><c:forEach var="r" items="${registrations}"><tr><td><span class="id-pill">#<c:out value="${r.registrationId}"/></span></td><td class="participant-cell"><strong><c:out value="${r.name}"/></strong></td><td><span><c:out value="${r.email}"/></span><small><c:out value="${r.phone}"/></small></td><td><c:out value="${r.eventName}"/></td><td><c:out value="${r.eventDate}"/></td><td><c:out value="${r.venue}"/></td><td><c:out value="${r.registrationDate}"/></td></tr></c:forEach></tbody></table></div></div></c:otherwise></c:choose>
</main><footer class="footer"><span>EventSpot</span><span>Discover something worth showing up for.</span></footer></body></html>
